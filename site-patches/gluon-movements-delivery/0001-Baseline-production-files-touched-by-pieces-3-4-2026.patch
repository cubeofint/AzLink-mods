+use Azuriom\Plugin\Shop\Controllers\Admin\UserPurchaseLimitResetController;
+use Azuriom\Plugin\Shop\Controllers\Admin\VariableController;
+use Illuminate\Support\Facades\Route;
+
+/*
+|--------------------------------------------------------------------------
+| Admin Routes
+|--------------------------------------------------------------------------
+|
+| Here is where you can register admin routes for your plugin. These
+| routes are loaded by the RouteServiceProvider within a group which
+| contains the "web" and "admin" middleware groups. Now create a great admin panel !
+|
+*/
+Route::middleware('can:shop.settings')->prefix('settings')->group(function () {
+    Route::get('/', [SettingController::class, 'show'])->name('settings');
+    Route::post('/', [SettingController::class, 'save'])->name('settings.save');
+});
+
+Route::middleware('can:shop.packages')->group(function () {
+    Route::resource('packages', PackageController::class)->except('show');
+    Route::resource('categories', CategoryController::class)->except(['index', 'show']);
+    Route::resource('variables', VariableController::class)->except('show');
+
+    Route::post('/packages/update-order', [PackageController::class, 'updateOrder'])->name('packages.update-order');
+    Route::post('/packages/{package}/duplicate',
+        [PackageController::class, 'duplicate'])->name('packages.duplicate');
+
+    Route::post('/users/{user}/purchase-limit-reset', [UserPurchaseLimitResetController::class, 'store'])
+        ->name('users.purchase-limit-reset');
+});
+
+Route::middleware('can:shop.privileges')->group(function () {
+    Route::resource('privileges', PrivilegeController::class)->except('show');
+    Route::post('/privileges/update-order', [PrivilegeController::class, 'updateOrder'])
+        ->name('privileges.update-order');
+});
+
+Route::middleware('can:shop.capabilities')->group(function () {
+    Route::resource('capabilities', CapabilityDefinitionController::class)->except('show');
+    Route::post('/capabilities/update-order', [CapabilityDefinitionController::class, 'updateOrder'])
+        ->name('capabilities.update-order');
+});
+
+Route::middleware('can:shop.kits')->group(function () {
+    Route::resource('kits', KitController::class)->except('show');
+    Route::post('/kits/update-order', [KitController::class, 'updateOrder'])->name('kits.update-order');
+    Route::post('/kits/item-icons', [KitController::class, 'storeItemIcon'])->name('kits.item-icons.store');
