@@ -0,0 +1,318 @@
+<?php
+
+namespace Azuriom\Plugin\Shop\Services;
+
+use Azuriom\Models\User;
+use Azuriom\Plugin\Shop\Enums\ConfiguredPurchaseStatus;
+use Azuriom\Plugin\Shop\Enums\UserPrivilegeEntitlementStatus;
+use Azuriom\Plugin\Shop\Exceptions\ConfiguredCheckoutException;
+use Azuriom\Plugin\Shop\Models\ConfiguredPrivilegePurchase;
+use Azuriom\Plugin\Shop\Models\UserPrivilegeEntitlement;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+
+class EntitlementLifecycleService
+{
+    public function assertCanCreateInitial(User $user, int $serverId): void
+    {
+        DB::transaction(function () use ($user, $serverId): void {
+            $entitlement = UserPrivilegeEntitlement::query()
+                ->where('user_id', $user->id)->where('server_id', $serverId)
+                ->lockForUpdate()->first();
+            if ($entitlement !== null) {
+                $this->assertTerminalForReuse($entitlement);
+            }
+        });
+    }
+
+    public function createInitialEntitlement(
+        ConfiguredPrivilegePurchase $purchase
+    ): UserPrivilegeEntitlement {
+        return DB::transaction(function () use ($purchase) {
+            $entitlement = $this->lockOrCreate($purchase);
+
+            if ($entitlement->current_purchase_id !== $purchase->id) {
+                $this->assertTerminalForReuse($entitlement);
+                $entitlement->forceFill($this->purchaseState($purchase, [
+                    'status' => UserPrivilegeEntitlementStatus::PendingActivation,
+                    'version' => $entitlement->version + 1,
+                ]))->save();
+            }
+
+            $this->assertValidState($entitlement);
+
+            return $entitlement->fresh();
+        });
+    }
+
+    public function getRenewalTail(User $user, int $serverId): ConfiguredPrivilegePurchase
+    {
+        return DB::transaction(function () use ($user, $serverId) {
+            $entitlement = $this->lock($user->id, $serverId);
+
+            return $this->tailLocked($entitlement);
+        });
+    }
+
+    public function getScheduledSuccessor(
+        ConfiguredPrivilegePurchase $purchase
+    ): ?ConfiguredPrivilegePurchase {
+        $children = ConfiguredPrivilegePurchase::query()
+            ->where('parent_purchase_id', $purchase->id)
+            ->lockForUpdate()
+            ->get();
+        if ($children->count() > 1) {
+            throw new LogicException("Purchase {$purchase->id} has a branching renewal chain.");
+        }
+
+        return $children->first();
+    }
+
+    public function activatePurchase(
+        User $user,
+        int $serverId,
+        int $purchaseId,
+        int $expectedVersion
+    ): UserPrivilegeEntitlement {
+        return DB::transaction(function () use ($user, $serverId, $purchaseId, $expectedVersion) {
+            $entitlement = $this->lock($user->id, $serverId);
+            $this->assertExpected($entitlement, $purchaseId, $expectedVersion);
+            $purchase = $this->lockedPurchase($purchaseId, $user->id, $serverId);
+
+            if ($purchase->starts_at->isFuture() || $purchase->expires_at->isPast()) {
+                throw new ConfiguredCheckoutException('purchase_not_activatable_now', 409);
+            }
+            if (! in_array($purchase->status, [
+                ConfiguredPurchaseStatus::PendingActivation,
+                ConfiguredPurchaseStatus::DeliveryFailed,
+            ], true)) {
+                throw new ConfiguredCheckoutException('invalid_purchase_transition', 409);
+            }
+
+            $purchase->update(['status' => ConfiguredPurchaseStatus::Active]);
+            $entitlement->forceFill($this->purchaseState($purchase, [
+                'status' => UserPrivilegeEntitlementStatus::Active,
+                'version' => $entitlement->version + 1,
+            ]))->save();
+            $this->assertValidState($entitlement);
+
+            return $entitlement->fresh();
+        });
+    }
+
+    public function expireCurrent(
+        User $user,
+        int $serverId,
+        int $expectedPurchaseId,
+        int $expectedVersion
+    ): UserPrivilegeEntitlement {
+        return DB::transaction(function () use ($user, $serverId, $expectedPurchaseId, $expectedVersion) {
+            $entitlement = $this->lock($user->id, $serverId);
+            $this->assertExpected($entitlement, $expectedPurchaseId, $expectedVersion);
+            if (now()->lt($entitlement->expires_at)) {
+                throw new ConfiguredCheckoutException('entitlement_not_expired', 409);
+            }
+
+            $current = $this->lockedPurchase($expectedPurchaseId, $user->id, $serverId);
+            $successor = $this->getScheduledSuccessor($current);
+            $current->update(['status' => ConfiguredPurchaseStatus::Expired]);
+
+            if ($successor !== null) {
+                $this->assertAdjacent($current, $successor);
+                if ($successor->status !== ConfiguredPurchaseStatus::Scheduled) {
+                    throw new LogicException('Expiration successor is not scheduled.');
+                }
+                $successor->update(['status' => ConfiguredPurchaseStatus::PendingActivation]);
+                $state = $this->purchaseState($successor, [
+                    'status' => UserPrivilegeEntitlementStatus::PendingActivation,
+                    'version' => $entitlement->version + 1,
+                ]);
+            } else {
+                $state = [
+                    'status' => UserPrivilegeEntitlementStatus::Expired,
+                    'version' => $entitlement->version + 1,
+                ];
+            }
+
+            $entitlement->forceFill($state)->save();
+            $this->assertValidState($entitlement);
+
+            return $entitlement->fresh();
+        });
+    }
+
+    public function revoke(
+        User $user,
+        int $serverId,
+        int $expectedPurchaseId,
+        int $expectedVersion
+    ): UserPrivilegeEntitlement {
+        return DB::transaction(function () use ($user, $serverId, $expectedPurchaseId, $expectedVersion) {
+            $entitlement = $this->lock($user->id, $serverId);
+            $this->assertExpected($entitlement, $expectedPurchaseId, $expectedVersion);
+            $purchase = $this->lockedPurchase($expectedPurchaseId, $user->id, $serverId);
+            $purchase->update(['status' => ConfiguredPurchaseStatus::Revoked]);
+            $entitlement->forceFill([
+                'status' => UserPrivilegeEntitlementStatus::Revoked,
+                'version' => $entitlement->version + 1,
+            ])->save();
+
+            return $entitlement->fresh();
+        });
+    }
+
+    private function lockOrCreate(
+        ConfiguredPrivilegePurchase $purchase
+    ): UserPrivilegeEntitlement {
+        $entitlement = UserPrivilegeEntitlement::query()
+            ->where('user_id', $purchase->user_id)
+            ->where('server_id', $purchase->server_id)
+            ->lockForUpdate()->first();
+        if ($entitlement !== null) {
+            return $entitlement;
+        }
+
+        try {
+            UserPrivilegeEntitlement::query()->create($this->purchaseState($purchase, [
+                'status' => UserPrivilegeEntitlementStatus::PendingActivation,
+                'version' => 1,
+            ]));
+        } catch (QueryException $exception) {
+            if (! str_contains($exception->getMessage(), 'shop_entitlement_user_server_uq')) {
+                throw $exception;
+            }
+        }
+
+        return $this->lock($purchase->user_id, $purchase->server_id);
+    }
+
+    private function lock(int $userId, int $serverId): UserPrivilegeEntitlement
+    {
+        return UserPrivilegeEntitlement::query()
+            ->where('user_id', $userId)->where('server_id', $serverId)
+            ->lockForUpdate()->firstOrFail();
+    }
+
+    private function tailLocked(
+        UserPrivilegeEntitlement $entitlement
+    ): ConfiguredPrivilegePurchase {
+        $current = $this->lockedPurchase(
+            $entitlement->current_purchase_id,
+            $entitlement->user_id,
+            $entitlement->server_id
+        );
+        $seen = [];
+
+        while (true) {
+            if (isset($seen[$current->id])) {
+                throw new LogicException('Renewal chain contains a cycle.');
+            }
+            $seen[$current->id] = true;
+            $child = $this->getScheduledSuccessor($current);
+            if ($child === null) {
+                return $current;
+            }
+            $this->assertAdjacent($current, $child);
+            if (
+                in_array($current->status, [
+                    ConfiguredPurchaseStatus::Revoked,
+                    ConfiguredPurchaseStatus::Refunded,
+                ], true)
+                && ! in_array($child->status, [
+                    ConfiguredPurchaseStatus::Expired,
+                    ConfiguredPurchaseStatus::Revoked,
+                    ConfiguredPurchaseStatus::Refunded,
+                ], true)
+            ) {
+                throw new LogicException('Terminal purchase has a nonterminal successor.');
+            }
+            $current = $child;
+        }
+    }
+
+    private function assertTerminalForReuse(UserPrivilegeEntitlement $entitlement): void
+    {
+        if (! in_array($entitlement->status, [
+            UserPrivilegeEntitlementStatus::Expired,
+            UserPrivilegeEntitlementStatus::Revoked,
+        ], true)) {
+            throw new ConfiguredCheckoutException('configured_entitlement_conflict', 422);
+        }
+        $tail = $this->tailLocked($entitlement);
+        if (! in_array($tail->status, [
+            ConfiguredPurchaseStatus::Expired,
+            ConfiguredPurchaseStatus::Revoked,
+            ConfiguredPurchaseStatus::Refunded,
+        ], true)) {
+            throw new ConfiguredCheckoutException('configured_chain_not_terminal', 422);
+        }
+    }
+
+    private function assertExpected(
+        UserPrivilegeEntitlement $entitlement,
+        int $purchaseId,
+        int $version
+    ): void {
+        if ($entitlement->version !== $version || $entitlement->current_purchase_id !== $purchaseId) {
+            throw new ConfiguredCheckoutException('stale_entitlement_version', 409);
+        }
+    }
+
+    private function assertValidState(UserPrivilegeEntitlement $entitlement): void
+    {
+        if ($entitlement->version < 1 || ! $entitlement->expires_at->gt($entitlement->effective_at)) {
+            throw new LogicException("Entitlement {$entitlement->id} violates interval/version invariants.");
+        }
+        $purchase = $entitlement->currentPurchase;
+        if (
+            $purchase === null
+            || $purchase->user_id !== $entitlement->user_id
+            || $purchase->server_id !== $entitlement->server_id
+        ) {
+            throw new LogicException("Entitlement {$entitlement->id} purchase identity is invalid.");
+        }
+    }
+
+    private function assertAdjacent(
+        ConfiguredPrivilegePurchase $parent,
+        ConfiguredPrivilegePurchase $child
+    ): void {
+        if (
+            $child->user_id !== $parent->user_id
+            || $child->server_id !== $parent->server_id
+            || $child->parent_purchase_id !== $parent->id
+            || ! $child->starts_at->equalTo($parent->expires_at)
+            || ! $child->expires_at->gt($child->starts_at)
+        ) {
+            throw new LogicException("Renewal edge {$parent->id} -> {$child->id} is invalid.");
+        }
+    }
+
+    private function lockedPurchase(int $id, int $userId, int $serverId): ConfiguredPrivilegePurchase
+    {
+        return ConfiguredPrivilegePurchase::query()->whereKey($id)
+            ->where('user_id', $userId)->where('server_id', $serverId)
+            ->lockForUpdate()->firstOrFail();
+    }
+
+    /**
+     * @param array<string, mixed> $overrides
+     * @return array<string, mixed>
+     */
+    private function purchaseState(
+        ConfiguredPrivilegePurchase $purchase,
+        array $overrides
+    ): array {
+        return [
+            'user_id' => $purchase->user_id,
+            'server_id' => $purchase->server_id,
+            'current_purchase_id' => $purchase->id,
+            'privilege_id' => $purchase->privilege_id,
+            'privilege_config_id' => $purchase->privilege_config_id,
+            'effective_at' => $purchase->starts_at,
+            'expires_at' => $purchase->expires_at,
+            ...$overrides,
+        ];
+    }
+}
diff --git a/plugins/shop/src/Services/MinecraftOperationDispatcher.php b/plugins/shop/src/Services/MinecraftOperationDispatcher.php
new file mode 100644
index 0000000..277962e
--- /dev/null
+++ b/plugins/shop/src/Services/MinecraftOperationDispatcher.php
@@ -0,0 +1,198 @@
+<?php
+
+namespace Azuriom\Plugin\Shop\Services;
+
+use Azuriom\Plugin\Shop\Data\KitRedeemRequest;
+use Azuriom\Plugin\Shop\Data\PrivilegeReconcileRequest;
+use Azuriom\Plugin\Shop\Data\PrivilegeRevokeRequest;
+use Azuriom\Plugin\Shop\Enums\MinecraftOperationStatus;
+use Azuriom\Plugin\Shop\Enums\MinecraftOperationType;
+use Azuriom\Plugin\Shop\Models\ConfiguredPrivilegePurchase;
+use Azuriom\Plugin\Shop\Models\MinecraftOperation;
+use Azuriom\Plugin\Shop\Models\UserPrivilegeEntitlement;
+use Azuriom\Plugin\Shop\Support\CanonicalJson;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Str;
+use InvalidArgumentException;
+use LogicException;
+
+class MinecraftOperationDispatcher
+{
+    public const PROTOCOL_VERSION = 1;
+
+    public function reconcile(PrivilegeReconcileRequest $request): MinecraftOperation
+    {
+        $this->assertEntitlementIdentity(
+            $request->entitlementId,
+            $request->purchaseId,
+            $request->serverId
+        );
+        $this->assertSemanticKey($request->entitlementKey);
+        $capabilities = $request->capabilities;
+        ksort($capabilities, SORT_STRING);
+
+        return $this->dispatch(
+            MinecraftOperationType::PrivilegeReconcile,
+            "entitlement:{$request->entitlementId}:version:{$request->entitlementVersion}:reconcile",
+            $request->serverId,
+            $request->playerUuid,
+            [
+                'schema_version' => 1,
+                'type' => MinecraftOperationType::PrivilegeReconcile->value,
+                'user' => ['uuid' => $request->playerUuid],
+                'entitlement' => [
+                    'id' => $request->entitlementId,
+                    'version' => $request->entitlementVersion,
+                    'purchase_id' => $request->purchaseId,
+                    'key' => $request->entitlementKey,
+                    'starts_at' => $request->startsAt->format(DATE_ATOM),
+                    'expires_at' => $request->expiresAt->format(DATE_ATOM),
+                ],
+                'capabilities' => $capabilities,
+            ],
+            $request->entitlementId,
+            $request->entitlementVersion,
+            $request->purchaseId,
+        );
+    }
+
+    public function revoke(PrivilegeRevokeRequest $request): MinecraftOperation
+    {
+        $this->assertEntitlementIdentity(
+            $request->entitlementId,
+            $request->purchaseId,
+            $request->serverId
+        );
+        $this->assertSemanticKey($request->entitlementKey);
+
+        return $this->dispatch(
+            MinecraftOperationType::PrivilegeRevoke,
+            "entitlement:{$request->entitlementId}:version:{$request->entitlementVersion}:revoke",
+            $request->serverId,
+            $request->playerUuid,
+            [
+                'schema_version' => 1,
+                'type' => MinecraftOperationType::PrivilegeRevoke->value,
+                'user' => ['uuid' => $request->playerUuid],
+                'entitlement' => [
+                    'id' => $request->entitlementId,
+                    'version' => $request->entitlementVersion,
+                    'purchase_id' => $request->purchaseId,
+                    'key' => $request->entitlementKey,
+                ],
+            ],
+            $request->entitlementId,
+            $request->entitlementVersion,
+            $request->purchaseId,
+        );
+    }
+
+    public function redeem(KitRedeemRequest $request): MinecraftOperation
+    {
+        if ($request->redemptionId < 1) {
+            throw new InvalidArgumentException('redemption_id is required.');
+        }
+        $this->assertPurchaseIdentity($request->purchaseId, $request->serverId);
+        $this->assertSemanticKey($request->deliveryKey);
+
+        return $this->dispatch(
+            MinecraftOperationType::KitRedeem,
+            "redemption:{$request->redemptionId}:redeem",
+            $request->serverId,
+            $request->playerUuid,
+            [
+                'schema_version' => 1,
+                'type' => MinecraftOperationType::KitRedeem->value,
+                'redemption_id' => $request->redemptionId,
+                'purchase_id' => $request->purchaseId,
+                'player_uuid' => $request->playerUuid,
+                'kit_key' => $request->deliveryKey,
+            ],
+            purchaseId: $request->purchaseId,
+            redemptionId: $request->redemptionId,
+        );
+    }
+
+    private function dispatch(
+        MinecraftOperationType $type,
+        string $operationKey,
+        int $serverId,
+        string $playerUuid,
+        array $payload,
+        ?int $entitlementId = null,
+        ?int $entitlementVersion = null,
+        ?int $purchaseId = null,
+        ?int $redemptionId = null,
+    ): MinecraftOperation {
+        if (! Str::isUuid($playerUuid)) {
+            throw new InvalidArgumentException('player_uuid must be a UUID.');
+        }
+        $payload = CanonicalJson::normalize($payload);
+        $hash = CanonicalJson::hash($payload);
+
+        $existing = MinecraftOperation::where('server_id', $serverId)
+            ->where('operation_key', $operationKey)->first();
+        if ($existing !== null) {
+            return $this->assertReplay($existing, $hash);
+        }
+
+        try {
+            return MinecraftOperation::create([
+                'operation_id' => (string) Str::uuid(),
+                'operation_key' => $operationKey,
+                'server_id' => $serverId,
+                'type' => $type,
+                'status' => MinecraftOperationStatus::Pending,
+                'entitlement_id' => $entitlementId,
+                'entitlement_version' => $entitlementVersion,
+                'purchase_id' => $purchaseId,
+                'redemption_id' => $redemptionId,
+                'player_uuid' => $playerUuid,
+                'protocol_version' => self::PROTOCOL_VERSION,
+                'payload' => $payload,
+                'payload_hash' => $hash,
+                'available_at' => now(),
+            ]);
+        } catch (QueryException $exception) {
+            $existing = MinecraftOperation::where('server_id', $serverId)
+                ->where('operation_key', $operationKey)->first();
+            if ($existing === null) {
+                throw $exception;
+            }
+
+            return $this->assertReplay($existing, $hash);
+        }
+    }
+
+    private function assertReplay(MinecraftOperation $operation, string $hash): MinecraftOperation
+    {
+        if (! hash_equals($operation->payload_hash, $hash)) {
+            throw new LogicException('Operation key was reused with a different payload.');
+        }
+
+        return $operation;
+    }
+
+    private function assertEntitlementIdentity(int $id, int $purchaseId, int $serverId): void
+    {
+        $exists = UserPrivilegeEntitlement::whereKey($id)
+            ->where('current_purchase_id', $purchaseId)->where('server_id', $serverId)->exists();
+        if (! $exists) {
+            throw new LogicException('Entitlement operation identity is invalid.');
+        }
+    }
+
+    private function assertPurchaseIdentity(int $id, int $serverId): void
+    {
+        if (! ConfiguredPrivilegePurchase::whereKey($id)->where('server_id', $serverId)->exists()) {
+            throw new LogicException('Purchase operation identity is invalid.');
+        }
+    }
+
+    private function assertSemanticKey(string $key): void
+    {
+        if (! preg_match('/^[a-z0-9][a-z0-9._-]{0,63}$/', $key)) {
+            throw new InvalidArgumentException('A configured semantic key is required.');
+        }
+    }
+}
