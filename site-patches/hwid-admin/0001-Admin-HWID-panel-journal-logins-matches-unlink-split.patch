+<?php
+
+namespace Azuriom\Http\Controllers\Admin;
+
+use Azuriom\Http\Controllers\Controller;
+use Azuriom\Models\User;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+
+class HwidManageController extends Controller
+{
+    /**
+     * Unlink the user from his HWID row (users.hwidId = NULL), optionally removing the launcher keys of that row.
+     */
+    public function unlink(Request $request, User $user)
+    {
+        $hwidId = $user->hwidId;
+
+        if ($hwidId === null) {
+            return to_route('admin.users.edit', $user)->with('error', trans('admin.users.hwid.actions.not_linked'));
+        }
+
+        $removeKeys = $request->boolean('remove_keys');
+        $admin = $request->user();
+
+        DB::transaction(function () use ($user, $hwidId, $removeKeys, $admin) {
+            $updated = DB::table('users')->where('id', $user->id)->where('hwidId', $hwidId)->update(['hwidId' => null]);
+
+            if ($updated === 0) {
+                return;
+            }
+
+            $this->log($hwidId, $user->id, 'unlink', [
+                'admin' => $admin->name,
+                'admin_id' => $admin->id,
+                'account' => $user->name,
+                'remove_keys' => $removeKeys,
+            ]);
+
+            if ($removeKeys) {
+                $this->removeKeys($hwidId, $user, $admin);
+            }
+        });
+
+        return to_route('admin.users.edit', $user)->with('success', trans('admin.users.hwid.actions.unlinked'));
+    }
+
+    /**
+     * Split another account off the HWID row shared with $user.
+     */
+    public function split(Request $request, User $user, User $other)
+    {
+        $hwidId = $user->hwidId;
+
+        if ($hwidId === null || $other->hwidId !== $hwidId || $other->is($user)) {
+            return to_route('admin.users.edit', $user)->with('error', trans('admin.users.hwid.actions.not_shared'));
+        }
+
+        $removeKeys = $request->boolean('remove_keys');
+        $admin = $request->user();
+
+        DB::transaction(function () use ($user, $other, $hwidId, $removeKeys, $admin) {
+            $updated = DB::table('users')->where('id', $other->id)->where('hwidId', $hwidId)->update(['hwidId' => null]);
+
+            if ($updated === 0) {
+                return;
+            }
+
+            $this->log($hwidId, $other->id, 'split', [
+                'admin' => $admin->name,
+                'admin_id' => $admin->id,
+                'account' => $other->name,
+                'from_user' => $user->name,
+                'reason' => 'admin split',
+                'remove_keys' => $removeKeys,
+            ]);
+
+            if ($removeKeys) {
+                $this->removeKeys($hwidId, $other, $admin);
+            }
+        });
+
+        return to_route('admin.users.edit', $user)->with('success', trans('admin.users.hwid.actions.split_done', ['user' => $other->name]));
+    }
+
+    private function removeKeys(int $hwidId, User $target, User $admin): void
+    {
+        $keyIds = DB::table('hwid_keys')->where('hwid_id', $hwidId)->pluck('id')->all();
+
+        DB::table('hwid_keys')->where('hwid_id', $hwidId)->delete();
+        DB::table('hwids')->where('id', $hwidId)->update(['publicKey' => null]);
+
+        $this->log($hwidId, $target->id, 'keys_removed', [
+            'admin' => $admin->name,
+            'admin_id' => $admin->id,
+            'removed_key_ids' => $keyIds,
+            'legacy_public_key_cleared' => true,
+        ]);
+    }
+
+    private function log(int $hwidId, int $userId, string $event, array $matched): void
+    {
+        DB::table('hwidLog')->insert([
+            'hwidId' => $hwidId,
+            'newPublicKey' => null,
+            'event' => $event,
+            'matched' => json_encode($matched, JSON_UNESCAPED_UNICODE),
+            'user_id' => $userId,
+            'ip' => null,
+            'created_at' => DB::raw('CURRENT_TIMESTAMP'),
+        ]);
+    }
+}
