diff --git a/app/Support/HwidPanel.php b/app/Support/HwidPanel.php
new file mode 100644
index 0000000..fbe0c0f
--- /dev/null
+++ b/app/Support/HwidPanel.php
@@ -0,0 +1,253 @@
+<?php
+
+namespace Azuriom\Support;
+
+use Azuriom\Models\User;
+use Carbon\Carbon;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Throwable;
+
+/**
+ * Data for the admin "HWID" block on the user page (hwids + hwid_keys + hwid_disks + hwidLog + login_history).
+ * Every section is fail-safe: a missing table/column never breaks the user page.
+ */
+class HwidPanel
+{
+    private const PLACEHOLDERS = [
+        'DEFAULTSTRING', 'TOBEFILLEDBYO.E.M.', 'TOBEFILLEDBYOEM', 'BSS-0123456789', 'NOTAPPLICABLE', 'NONE', 'NA', 'N/A',
+        'MB-1234567890', 'SYSTEMSERIALNUMBER', 'CHASSISSERIALNUMBER', 'BOARDSERIALNUMBER', 'DEFAULT', 'UNKNOWN', 'NULL',
+        'NOTSPECIFIED', 'SN-ON-THE-LABLE', 'SN-ON-THE-LABEL', '0123456789ABCDEF', '123456789', 'O.E.M', 'OEM', '0',
+        '03000200-0400-0500-0006-000700080009', 'FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF', '00000000-0000-0000-0000-000000000000',
+    ];
+
+    private const MATCH_LIMIT = 100;
+
+    /** Normalized like LaunchServer HardwareIds: trim, drop spaces, upper case. */
+    public static function normalize(?string $value): ?string
+    {
+        if ($value === null) {
+            return null;
+        }
+
+        $value = Str::upper(str_replace(' ', '', trim($value)));
+
+        return $value === '' ? null : $value;
+    }
+
+    public static function isPlaceholder(?string $value): bool
+    {
+        $norm = self::normalize($value);
+
+        if ($norm === null) {
+            return true;
+        }
+
+        $stripped = str_replace('-', '', $norm);
+        foreach (self::PLACEHOLDERS as $placeholder) {
+            if ($norm === $placeholder || $stripped === str_replace('-', '', $placeholder)) {
+                return true;
+            }
+        }
+
+        if (strlen($norm) < 8) {
+            return true;
+        }
+
+        $bare = preg_replace('/[-_.]/', '', $norm) ?? $norm;
+
+        if ($bare === '' || preg_match('/^[0F]+$/', $bare) === 1 || preg_match('/^(.)\1*$/', $bare) === 1 || preg_match('/^0+[0-9]$/', $bare) === 1) {
+            return true;
+        }
+
+        // NVMe EUI-like ids that are mostly zeros (0000_0000_0000_0000_4868_3400_0000_0000.)
+        return strlen($bare) >= 12 && substr_count($bare, '0') >= strlen($bare) * 0.6;
+    }
+
+    public static function json(?string $value): array
+    {
+        if ($value === null || $value === '') {
+            return [];
+        }
+
+        $decoded = json_decode($value, true);
+
+        return is_array($decoded) ? array_values(array_filter($decoded, fn ($v) => is_scalar($v) && (string) $v !== '')) : [];
+    }
+
+    public static function time(?string $value): ?string
+    {
+        if ($value === null || $value === '') {
+            return null;
+        }
+
+        try {
+            // TIMESTAMP columns come back in the DB session zone (server: UTC)
+            return Carbon::parse($value, 'UTC')->setTimezone(config('app.timezone'))->format('d.m.Y H:i:s');
+        } catch (Throwable) {
+            return $value;
+        }
+    }
+
+    public static function forUser(User $user, int $perPage = 25): array
+    {
+        $hwid = self::safe(fn () => $user->hwidId ? DB::table('hwids')->where('id', $user->hwidId)->first() : null);
+
+        return [
+            'hwid' => $hwid,
+            'extended' => $hwid !== null && property_exists($hwid, 'system_uuid'),
+            'disks' => $hwid ? self::json($hwid->disk_serials ?? null) : [],
+            'macs' => $hwid ? self::json($hwid->macs ?? null) : [],
+            'monitors' => $hwid ? self::json($hwid->monitor_serials ?? null) : [],
+            'keys' => $hwid ? self::keys($hwid->id) : null,
+            'log' => self::log($user),
+            'logins' => self::logins($user, $perPage),
+            'loginStats' => self::loginStats($user),
+            'matches' => self::matches($user, $hwid),
+        ];
+    }
+
+    private static function keys(int $hwidId): ?object
+    {
+        return self::safe(fn () => DB::table('hwid_keys')
+            ->where('hwid_id', $hwidId)
+            ->selectRaw('COUNT(*) AS total, MAX(last_seen_at) AS last_seen, MIN(created_at) AS first_seen')
+            ->first());
+    }
+
+    private static function log(User $user): Collection
+    {
+        return self::safe(function () use ($user) {
+            $query = DB::table('hwidLog AS l')
+                ->leftJoin('users AS u', 'u.id', '=', 'l.user_id')
+                ->select('l.id', 'l.hwidId', 'l.event', 'l.score', 'l.matched', 'l.user_id', 'l.ip', 'l.created_at', 'u.name AS user_name')
+                ->where(function ($q) use ($user) {
+                    $q->where('l.user_id', $user->id);
+                    if ($user->hwidId) {
+                        $q->orWhere('l.hwidId', $user->hwidId);
+                    }
+                })
+                ->orderByDesc('l.id')
+                ->limit(50);
+
+            return $query->get()->map(function ($row) {
+                $decoded = $row->matched ? json_decode($row->matched, true) : null;
+                $row->matched_pretty = $decoded !== null
+                    ? json_encode($decoded, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)
+                    : $row->matched;
+
+                return $row;
+            });
+        }, collect());
+    }
+
+    private static function logins(User $user, int $perPage)
+    {
+        return self::safe(fn () => DB::table('login_history')
+            ->where('user_id', $user->id)
+            ->orderByDesc('id')
+            ->paginate($perPage, ['*'], 'lh_page')
+            ->withQueryString()
+            ->fragment('userHwidLogins'));
+    }
+
+    private static function loginStats(User $user): ?object
+    {
+        return self::safe(fn () => DB::table('login_history')
+            ->where('user_id', $user->id)
+            ->selectRaw("COUNT(*) AS total, COUNT(DISTINCT ip) AS ips, SUM(source = 'launcher') AS launcher, SUM(source = 'site') AS site, SUM(result <> 'success') AS failed")
+            ->first());
+    }
+
+    /** @return array<int, array{user: object, signals: list<string>}> */
+    private static function matches(User $user, ?object $hwid): array
+    {
+        $signals = [];
+
+        $add = function (iterable $users, string $signal) use (&$signals, $user) {
+            foreach ($users as $row) {
+                if ((int) $row->id === (int) $user->id) {
+                    continue;
+                }
+                $signals[$row->id]['user'] = $row;
+                $signals[$row->id]['signals'][$signal] = true;
+            }
+        };
+
+        $usersOnHwids = function (Collection $hwidIds) {
+            $ids = $hwidIds->filter()->unique()->take(self::MATCH_LIMIT);
+
+            return $ids->isEmpty() ? collect() : DB::table('users')->whereIn('hwidId', $ids)->limit(self::MATCH_LIMIT)
+                ->get(['id', 'name', 'hwidId', 'is_banned', 'deleted_at']);
+        };
+
+        if ($hwid !== null) {
+            self::safe(fn () => $add($usersOnHwids(collect([$hwid->id])), 'тот же HWID'));
+
+            $serials = collect(self::json($hwid->disk_serials ?? null))
+                ->push($hwid->hwDiskId ?? null)
+                ->map(fn ($s) => self::normalize($s))
+                ->filter(fn ($s) => $s !== null && ! self::isPlaceholder($s))
+                ->unique()->values();
+
+            if ($serials->isNotEmpty()) {
+                self::safe(function () use ($serials, $hwid, $add, $usersOnHwids) {
+                    $ids = DB::table('hwid_disks')->whereIn('serial', $serials)->where('hwid_id', '<>', $hwid->id)
+                        ->limit(self::MATCH_LIMIT)->pluck('hwid_id');
+                    $add($usersOnHwids($ids), 'диск');
+                });
+            }
+
+            foreach (['system_uuid' => 'System UUID', 'machine_guid' => 'MachineGuid', 'device_tag' => 'device tag'] as $column => $label) {
+                $value = $hwid->{$column} ?? null;
+                if ($value === null || self::isPlaceholder($value)) {
+                    continue;
+                }
+                self::safe(function () use ($column, $value, $hwid, $add, $usersOnHwids, $label) {
+                    $ids = DB::table('hwids')->where($column, $value)->where('id', '<>', $hwid->id)->limit(self::MATCH_LIMIT)->pluck('id');
+                    $add($usersOnHwids($ids), $label);
+                });
+            }
+        }
+
+        self::safe(function () use ($user, $add) {
+            $ips = DB::table('login_history')->where('user_id', $user->id)->whereNotNull('ip')->distinct()->limit(200)->pluck('ip');
+            if (! empty($user->last_login_ip)) {
+                $ips->push($user->last_login_ip);
+            }
+            $ips = $ips->filter()->unique()->values();
+            if ($ips->isEmpty()) {
+                return;
+            }
+            $fromHistory = DB::table('login_history')->whereIn('ip', $ips)->where('user_id', '<>', $user->id)
+                ->whereNotNull('user_id')->distinct()->limit(self::MATCH_LIMIT)->pluck('user_id');
+            $rows = DB::table('users')
+                ->where(fn ($q) => $q->whereIn('id', $fromHistory)->orWhereIn('last_login_ip', $ips))
+                ->limit(self::MATCH_LIMIT)
+                ->get(['id', 'name', 'hwidId', 'is_banned', 'deleted_at']);
+            $add($rows, 'IP');
+        });
+
+        $result = [];
+        foreach ($signals as $id => $entry) {
+            $result[] = ['user' => $entry['user'], 'signals' => array_keys($entry['signals'])];
+        }
+
+        usort($result, fn ($a, $b) => [count($b['signals']), $a['user']->name] <=> [count($a['signals']), $b['user']->name]);
+
+        return $result;
+    }
+
+    private static function safe(callable $callback, mixed $default = null): mixed
+    {
+        try {
+            return $callback();
+        } catch (Throwable $e) {
+            Log::warning('[hwid-panel] '.$e->getMessage());
+
+            return $default;
+        }
+    }
+}
diff --git a/app/Support/LoginHistory.php b/app/Support/LoginHistory.php
new file mode 100644
index 0000000..a8b2c07
--- /dev/null
+++ b/app/Support/LoginHistory.php
@@ -0,0 +1,36 @@
+<?php
+
+namespace Azuriom\Support;
+
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Throwable;
+
+/**
+ * Writes site logins into login_history (shared with LaunchServer, source = 'site').
+ * Never throws: a logging problem must not break the login itself.
+ */
+class LoginHistory
+{
+    public static function record(?int $userId, Request $request, string $result, string $source = 'site'): void
+    {
+        if ($userId === null) {
+            return;
+        }
+
+        try {
+            DB::table('login_history')->insert([
+                'user_id' => $userId,
+                'source' => Str::limit($source, 16, ''),
+                'ip' => Str::limit((string) $request->ip(), 45, '') ?: null,
+                'client' => Str::limit((string) $request->userAgent(), 255, '') ?: null,
+                'hwid_id' => null,
+                'result' => Str::limit($result, 16, ''),
+            ]);
+        } catch (Throwable $e) {
+            Log::warning('[login-history] not written: '.$e->getMessage());
+        }
+    }
+}
