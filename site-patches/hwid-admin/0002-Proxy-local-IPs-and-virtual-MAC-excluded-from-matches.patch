     private const MATCH_LIMIT = 100;
 
+    /** Public addresses of the site/launcher host itself (traffic seen from the local proxy). */
+    private const SERVER_IPS = ['114.129.9.184', '100.92.36.110'];
+
+    /** Virtual adapters that every Windows install reports (RAS "DEST"), never a hardware signal. */
+    private const VIRTUAL_MACS = ['444553544F53'];
+
+    /**
+     * Loopback, private (10/8, 172.16/12, 192.168/16, fc00::/7), CGNAT 100.64/10, link-local and reserved ranges,
+     * plus this server's own addresses: the IP was seen through the local proxy and identifies nobody.
+     */
+    public static function isProxyIp(?string $ip): bool
+    {
+        $ip = trim((string) $ip);
+
+        if ($ip === '') {
+            return true;
+        }
+
+        if (str_starts_with(strtolower($ip), '::ffff:') && filter_var(substr($ip, 7), FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) {
+            $ip = substr($ip, 7);
+        }
+
+        if (filter_var($ip, FILTER_VALIDATE_IP) === false) {
+            return true;
+        }
+
+        if (in_array($ip, self::SERVER_IPS, true)) {
+            return true;
+        }
+
+        if (filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) {
+            $long = ip2long($ip);
+            if (($long & 0xFFC00000) === (ip2long('100.64.0.0') & 0xFFC00000)) {
+                return true;
+            }
+        } elseif (preg_match('/^fe[89ab]/i', $ip) === 1) {
+            return true;
+        }
+
+        return filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE) === false;
+    }
+
+    public static function isVirtualMac(?string $mac): bool
+    {
+        $bare = strtoupper(preg_replace('/[^0-9A-Fa-f]/', '', (string) $mac) ?? '');
+
+        return $bare === '' || in_array($bare, self::VIRTUAL_MACS, true) || preg_match('/^(0+|F+)$/', $bare) === 1;
+    }
+
