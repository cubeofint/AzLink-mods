diff --git a/tests/Feature/CurrencyServerSyncTest.php b/tests/Feature/CurrencyServerSyncTest.php
new file mode 100644
index 0000000..8688c68
--- /dev/null
+++ b/tests/Feature/CurrencyServerSyncTest.php
@@ -0,0 +1,218 @@
+<?php
+
+namespace Tests\Feature;
+
+use Azuriom\Models\CurrencyServerMovement;
+use Azuriom\Models\CurrencyServerOperation as Op;
+use Azuriom\Models\CurrencyTransaction;
+use Azuriom\Models\Server;
+use Azuriom\Models\User;
+use Azuriom\Models\UserServerBalance;
+use Azuriom\Services\Currency\CurrencyLedger;
+use Azuriom\Services\Currency\CurrencyServerSync;
+use Azuriom\Services\Currency\ServerMovementRecorder;
+use Azuriom\Services\Currency\ServerOperationQueue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+use RuntimeException;
+use Tests\TestCase;
+
+/**
+ * Requires a booted Azuriom app (phpunit.xml + sqlite).
+ *
+ *   cd /var/www/main-site
+ *   php artisan test --filter=CurrencyServerSyncTest
+ *
+ * These tests assume settings() and Eloquent work as on production.
+ */
+class CurrencyServerSyncTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private User $user;
+
+    private Server $server;
+
+    private CurrencyServerSync $sync;
+
+    private ServerOperationQueue $queue;
+
+    private CurrencyLedger $ledger;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->user = User::factory()->create(['game_id' => 'f3fc162dd34432fa8c9a0b987b0791cf', 'coins' => 0]);
+        $this->server = Server::query()->create([
+            'name' => 'ATM10-Test',
+            'address' => '127.0.0.1',
+            'type' => 'mc-azlink',
+            'port' => 25565,
+            'data' => [],
+        ]);
+
+        DB::table('settings')->updateOrInsert(['name' => 'currency.server_queue_enabled'], ['value' => '1']);
+        DB::table('settings')->updateOrInsert(['name' => 'currency.server_queue_servers'], ['value' => (string) $this->server->id]);
+
+        $this->ledger = app(CurrencyLedger::class);
+        $this->sync = app(CurrencyServerSync::class);
+        $this->queue = app(ServerOperationQueue::class);
+
+        $this->ledger->adjustServerBalance($this->user, $this->server->id, 100, CurrencyTransaction::TYPE_ADMIN, [
+            'source' => 'seed',
+        ]);
+    }
+
+    public function test_enqueue_credit_and_debit(): void
+    {
+        $credit = $this->sync->adjust($this->user, $this->server, 50, 'Компенсация', ['source' => 'admin_user_edit']);
+        $this->assertSame(Op::ADJUST, $credit->direction);
+        $this->assertSame(50, (int) $credit->amount);
+        $this->assertSame(Op::PENDING, $credit->status);
+        $this->assertEquals(150, $this->ledger->serverBalance($this->user, $this->server->id));
+
+        $debit = $this->sync->adjust($this->user, $this->server, -30, 'штраф', ['source' => 'admin_user_edit']);
+        $this->assertSame(-30, (int) $debit->amount);
+        $this->assertEquals(120, $this->ledger->serverBalance($this->user, $this->server->id));
+    }
+
+    public function test_idempotent_enqueue(): void
+    {
+        $id = 'aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee';
+        $first = $this->sync->adjust($this->user, $this->server, 10, 'once', ['source' => 'api'], $id);
+        $second = $this->sync->adjust($this->user, $this->server, 10, 'once', ['source' => 'api'], $id);
+        $this->assertSame($first->id, $second->id);
+        $this->assertEquals(1, Op::query()->where('id', $id)->count());
