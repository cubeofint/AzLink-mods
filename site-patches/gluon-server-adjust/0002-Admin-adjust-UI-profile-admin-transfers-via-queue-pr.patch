--- /dev/null
+++ b/app/Console/Commands/CurrencyServerSyncProbeCommand.php
@@ -0,0 +1,69 @@
+<?php
+
+namespace Azuriom\Console\Commands;
+
+use Azuriom\Models\Server;
+use Azuriom\Models\User;
+use Azuriom\Models\UserServerBalance;
+use Azuriom\Services\Currency\CurrencyServerSync;
+use Azuriom\Services\Currency\ServerOperationQueue;
+use Illuminate\Console\Command;
+
+/**
+ * Enqueue 0-amount reconcile probes so the game reports its wallet via ack balance_after.
+ */
+class CurrencyServerSyncProbeCommand extends Command
+{
+    protected $signature = 'currency:server-sync-probe {server : server id} {user? : user id or name}';
+
+    protected $description = 'Enqueue 0-amount reconcile probes for one user or all users with a balance on the server';
+
+    public function handle(CurrencyServerSync $sync): int
+    {
+        $serverId = (int) $this->argument('server');
+        $server = Server::query()->find($serverId);
+
+        if ($server === null) {
+            $this->error('Server not found');
+
+            return self::FAILURE;
+        }
+
+        if (! ServerOperationQueue::enabledFor($server)) {
+            $this->error('Queue is not enabled for this server (currency.server_queue_enabled / currency.server_queue_servers / type mc-azlink)');
+
+            return self::FAILURE;
+        }
+
+        $userArg = $this->argument('user');
+
+        if ($userArg !== null) {
+            $user = ctype_digit((string) $userArg)
+                ? User::query()->find((int) $userArg)
+                : User::query()->where('name', $userArg)->first();
+
+            if ($user === null) {
+                $this->error('User not found');
+
+                return self::FAILURE;
+            }
+
+            $users = collect([$user]);
+        } else {
+            $ids = UserServerBalance::query()->where('server_id', $serverId)->pluck('user_id');
+            $users = User::query()->whereIn('id', $ids)->get();
+        }
+
+        $count = 0;
+
+        foreach ($users as $user) {
+            $op = $sync->adjust($user, $server, 0, 'reconcile', ['source' => 'reconcile']);
+            $this->line("probe {$op->id} user {$user->id} {$user->name}");
+            $count++;
+        }
+
+        $this->info("Queued {$count} probe(s)");
+
+        return self::SUCCESS;
+    }
+}
