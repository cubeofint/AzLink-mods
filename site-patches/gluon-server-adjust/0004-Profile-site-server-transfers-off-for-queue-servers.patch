diff --git b/tests/Feature/ProfileCoinsTransferQueueTest.php b/tests/Feature/ProfileCoinsTransferQueueTest.php
new file mode 100644
index 0000000..cd20d00
--- /dev/null
+++ b/tests/Feature/ProfileCoinsTransferQueueTest.php
@@ -0,0 +1,133 @@
+<?php
+
+namespace Tests\Feature;
+
+use Azuriom\Http\View\Composers\ServerComposer;
+use Azuriom\Models\CurrencyServerOperation;
+use Azuriom\Models\Server;
+use Azuriom\Models\Setting;
+use Azuriom\Models\User;
+use Azuriom\Services\Currency\CurrencyLedger;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+/**
+ * Site <-> server transfers from the profile are refused for servers where the gluon queue
+ * is on (site copy authoritative; players use /pay in game). Other servers keep working.
+ */
+class ProfileCoinsTransferQueueTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private User $user;
+
+    private Server $queued;
+
+    private Server $legacy;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->user = User::factory()->create(['game_id' => 'f3fc162dd34432fa8c9a0b987b0791cf', 'coins' => 500]);
+        $this->queued = Server::query()->create([
+            'name' => 'ATM10-Test', 'address' => '127.0.0.1', 'type' => 'mc-azlink', 'port' => 25565, 'data' => [],
+        ]);
+        $this->legacy = Server::query()->create([
+            'name' => 'Legacy', 'address' => '127.0.0.2', 'type' => 'mc-azlink', 'port' => 25566, 'data' => [],
+        ]);
+        Server::query()->update(['home_display' => true]);
+
+        // ServerComposer caches the server list in statics across requests/tests.
+        foreach (['servers', 'server'] as $prop) {
+            $ref = new \ReflectionProperty(ServerComposer::class, $prop);
+            $ref->setValue(null, null);
+        }
+
+        Setting::updateSettings([
+            'currency.use_coins' => '1',
+            'currency.server_queue_servers' => (string) $this->queued->id,
+            'currency.server_queue_enabled' => '1',
+        ]);
+    }
+
+    public function test_transfer_refused_for_queue_server(): void
+    {
+        foreach (['to_server', 'to_site'] as $direction) {
+            $this->actingAs($this->user)
+                ->from('/profile')
+                ->post(route('profile.transfer-coins'), [
+                    'direction' => $direction,
+                    'server_id' => $this->queued->id,
+                    'amount' => 10,
+                ])
+                ->assertRedirect('/profile')
+                ->assertSessionHasErrors(['server_id' => trans('messages.profile.coins_transfer.disabled_for_server')]);
+        }
+
+        $this->assertSame(0, CurrencyServerOperation::query()->count());
+        $this->assertEquals(500, (float) $this->user->fresh()->coins);
+        $this->assertEquals(0, app(CurrencyLedger::class)->serverBalance($this->user, $this->queued->id));
+    }
+
+    public function test_transfer_unchanged_for_other_servers(): void
+    {
+        $this->actingAs($this->user)
+            ->from('/profile')
+            ->post(route('profile.transfer-coins'), [
+                'direction' => 'to_server',
+                'server_id' => $this->legacy->id,
+                'amount' => 10,
+            ])
+            ->assertSessionHasNoErrors();
+
+        $this->assertEquals(490, (float) $this->user->fresh()->coins);
+        $this->assertEquals(10, app(CurrencyLedger::class)->serverBalance($this->user, $this->legacy->id));
+        $this->assertSame(0, CurrencyServerOperation::query()->count());
+    }
+
+    public function test_queue_off_keeps_legacy_transfer_for_all_servers(): void
+    {
+        Setting::updateSettings('currency.server_queue_enabled', '0');
+
+        $this->actingAs($this->user)
+            ->from('/profile')
+            ->post(route('profile.transfer-coins'), [
+                'direction' => 'to_server',
+                'server_id' => $this->queued->id,
+                'amount' => 10,
+            ])
+            ->assertSessionHasNoErrors();
+
+        $this->assertEquals(10, app(CurrencyLedger::class)->serverBalance($this->user, $this->queued->id));
+    }
+
+    public function test_profile_passes_transfer_disabled_server_ids(): void
+    {
+        $this->actingAs($this->user)->get(route('profile.index'))
+            ->assertOk()
+            ->assertViewHas('transferDisabledServerIds', [$this->queued->id]);
+
+        Setting::updateSettings('currency.server_queue_enabled', '0');
+
+        $this->actingAs($this->user)->get(route('profile.index'))
+            ->assertOk()
+            ->assertViewHas('transferDisabledServerIds', []);
+    }
+
+    public function test_coints_theme_hides_queue_server_from_transfer_form(): void
+    {
+        if (! is_file(public_path('assets/themes/coints/css/theme.css')) || ! is_file(public_path('assets/themes/coints/js/theme.js'))) {
+            $this->markTestSkipped('coints theme assets are not published in this checkout');
+        }
+
+        Setting::updateSettings('theme', 'coints');
+        themes()->loadTheme('coints');
+
+        $html = $this->actingAs($this->user)->get(route('profile.index'))->assertOk()->getContent();
+
+        $this->assertStringContainsString(e(trans('messages.profile.coins_transfer.disabled_hint', ['servers' => 'ATM10-Test'])), $html);
+        $this->assertStringContainsString('Legacy (', $html);
+        $this->assertStringNotContainsString('ATM10-Test (', $html);
+    }
+}
