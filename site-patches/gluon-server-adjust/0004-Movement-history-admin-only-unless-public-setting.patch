From 695b5047af5cbde7d92046331b3961c9873564c7 Mon Sep 17 00:00:00 2001
From: mawleesys <alsoalberdo@gmail.com>
Date: Thu, 8 Oct 2026 09:48:21 +0500
Subject: [PATCH] Movement history tab: admin only unless
 currency.server_movements_public

CurrencyServerMovement::visibleTo(): the profile tab and partial are shown
only when movements are enabled and the user has admin.access or the new
setting currency.server_movements_public (default off) is set. Receiving
movements from servers is still governed by server_movements_enabled.
---
 app/Models/CurrencyServerMovement.php         | 14 ++++
 .../coints/views/profile/index.blade.php      |  4 +-
 .../profile/_currency-movements.blade.php     |  2 +
 .../CurrencyMovementVisibilityTest.php        | 71 +++++++++++++++++++
 4 files changed, 89 insertions(+), 2 deletions(-)
 create mode 100644 tests/Feature/CurrencyMovementVisibilityTest.php

diff --git a/app/Models/CurrencyServerMovement.php b/app/Models/CurrencyServerMovement.php
index 06b5a2a..26f7723 100644
--- a/app/Models/CurrencyServerMovement.php
+++ b/app/Models/CurrencyServerMovement.php
@@ -75,4 +75,18 @@ class CurrencyServerMovement extends Model
     {
         return (bool) setting('currency.server_movements_enabled', false);
     }
+
+    /**
+     * Whether the player-facing movement history may be shown to this user.
+     * Receiving movements from servers is governed by enabled() alone.
+     */
+    public static function visibleTo(?User $user): bool
+    {
+        if ($user === null || ! self::enabled()) {
+            return false;
+        }
+
+        return $user->can('admin.access')
+            || (bool) setting('currency.server_movements_public', false);
+    }
 }
