diff --git a/tests/Feature/CurrencyMovementVisibilityTest.php b/tests/Feature/CurrencyMovementVisibilityTest.php
new file mode 100644
index 0000000..6c61931
--- /dev/null
+++ b/tests/Feature/CurrencyMovementVisibilityTest.php
@@ -0,0 +1,71 @@
+<?php
+
+namespace Tests\Feature;
+
+use Azuriom\Models\CurrencyServerMovement;
+use Azuriom\Models\Role;
+use Azuriom\Models\Setting;
+use Azuriom\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+/**
+ *   php artisan test --filter=CurrencyMovementVisibilityTest
+ */
+class CurrencyMovementVisibilityTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private User $player;
+
+    private User $admin;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->player = User::factory()->create([
+            'role_id' => Role::query()->create(['name' => 'Player', 'color' => '999999', 'power' => 0, 'is_admin' => false])->id,
+        ]);
+        $this->admin = User::factory()->create([
+            'role_id' => Role::query()->create(['name' => 'Admin', 'color' => 'ff0000', 'power' => 100, 'is_admin' => true])->id,
+        ]);
+    }
+
+    public function test_hidden_for_everyone_when_movements_disabled(): void
+    {
+        Setting::updateSettings(['currency.server_movements_enabled' => '0', 'currency.server_movements_public' => '1']);
+
+        $this->assertFalse(CurrencyServerMovement::visibleTo($this->admin));
+        $this->assertFalse(CurrencyServerMovement::visibleTo($this->player));
+        $this->assertFalse(CurrencyServerMovement::visibleTo(null));
+    }
+
+    public function test_admin_only_by_default(): void
+    {
+        Setting::updateSettings(['currency.server_movements_enabled' => '1']);
+
+        $this->assertTrue(CurrencyServerMovement::visibleTo($this->admin));
+        $this->assertFalse(CurrencyServerMovement::visibleTo($this->player));
+        $this->assertFalse(CurrencyServerMovement::visibleTo(null));
+    }
+
+    public function test_public_setting_shows_to_players(): void
+    {
+        Setting::updateSettings(['currency.server_movements_enabled' => '1', 'currency.server_movements_public' => '1']);
+
+        $this->assertTrue(CurrencyServerMovement::visibleTo($this->player));
+        $this->assertTrue(CurrencyServerMovement::visibleTo($this->admin));
+    }
+
+    public function test_partial_renders_nothing_for_player(): void
+    {
+        Setting::updateSettings(['currency.server_movements_enabled' => '1']);
+
+        $this->actingAs($this->player);
+        $this->assertStringNotContainsString('Движение валют', view('profile._currency-movements')->render());
+
+        $this->actingAs($this->admin);
+        $this->assertStringContainsString('Движение валют', view('profile._currency-movements')->render());
+    }
+}
