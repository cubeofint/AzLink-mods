diff --git a/app/Services/Currency/CurrencyServerSync.php b/app/Services/Currency/CurrencyServerSync.php
new file mode 100644
index 0000000..cc731b1
--- /dev/null
+++ b/app/Services/Currency/CurrencyServerSync.php
@@ -0,0 +1,119 @@
+<?php
+
+namespace Azuriom\Services\Currency;
+
+use Azuriom\Models\CurrencyServerOperation as Op;
+use Azuriom\Models\CurrencyTransaction;
+use Azuriom\Models\Server;
+use Azuriom\Models\User;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+use InvalidArgumentException;
+
+/**
+ * Authoritative per-server gluon adjustments. When the queue is on for the server,
+ * the site copy is updated immediately and a direction=adjust operation is queued
+ * for the game. Reconcile ops never mutate the site copy (the site is already correct).
+ */
+class CurrencyServerSync
+{
+    public function __construct(private CurrencyLedger $ledger)
+    {
+    }
+
+    public function adjust(
+        User $user,
+        Server|int $server,
+        int $delta,
+        string $reason,
+        array $meta = [],
+        ?string $operationId = null
+    ): Op|CurrencyTransaction {
+        $serverId = $server instanceof Server ? (int) $server->id : (int) $server;
+        $reason = Str::limit(trim($reason), 190, '');
+        $source = (string) ($meta['source'] ?? 'api');
+        $isReconcile = $source === 'reconcile';
+
+        if ($delta === 0 && ! $isReconcile) {
+            throw new InvalidArgumentException('Amount must be a non-zero integer.');
+        }
+
+        if (! ServerOperationQueue::enabledFor($serverId)) {
+            if ($delta === 0) {
+                throw new InvalidArgumentException('Amount must be a non-zero integer.');
+            }
+
+            return $this->ledger->adjustServerBalance($user, $serverId, $delta, CurrencyTransaction::TYPE_ADMIN, [
+                'reason' => $reason,
+                ...$meta,
+            ]);
+        }
+
+        $id = $operationId ?? (string) Str::uuid();
+
+        if ($existing = Op::find($id)) {
+            return $existing;
+        }
+
+        return DB::transaction(function () use ($user, $serverId, $delta, $reason, $meta, $source, $isReconcile, $id) {
+            if ($delta !== 0 && ! $isReconcile) {
+                $this->ledger->adjustServerBalance(
+                    $user,
+                    $serverId,
+                    $delta,
+                    CurrencyTransaction::TYPE_SERVER_ADJUST,
+                    [
+                        'reason' => $reason,
+                        'operation_id' => $id,
+                        'status' => Op::PENDING,
+                        ...$meta,
+                    ],
+                    "op:{$id}:site",
+                );
+            }
+
+            return Op::create([
+                'id' => $id,
+                'user_id' => $user->id,
+                'server_id' => $serverId,
+                'direction' => Op::ADJUST,
+                'amount' => $delta,
+                'status' => Op::PENDING,
+                'meta' => array_filter([
+                    'reason' => $reason,
+                    'source' => $source,
+                    ...$meta,
+                ], fn ($v) => $v !== null && $v !== ''),
+            ]);
+        });
+    }
+
+    /**
+     * If the game reports a wallet total and nothing is pending, enqueue at most one
+     * reconcile adjust so the game converges to the site copy.
+     */
+    public function maybeReconcileDrift(User $user, int $serverId, ?int $balanceAfter): void
+    {
+        if ($balanceAfter === null || ! ServerOperationQueue::enabledFor($serverId)) {
+            return;
+        }
+
+        $pending = Op::query()
+            ->where('user_id', $user->id)
+            ->where('server_id', $serverId)
+            ->where('status', Op::PENDING)
+            ->get();
+
+        if ($pending->isNotEmpty()) {
+            return;
+        }
+
+        $site = (int) round($this->ledger->serverBalance($user, $serverId));
+
+        if ($site === $balanceAfter) {
+            return;
+        }
+
+        $this->adjust($user, $serverId, $site - $balanceAfter, 'reconcile', ['source' => 'reconcile']);
+    }
+}
