index 0000000..8befcd6
--- /dev/null
+++ b/app/Http/Controllers/Admin/PrefixOperationController.php
@@ -0,0 +1,42 @@
+<?php
+
+namespace Azuriom\Http\Controllers\Admin;
+
+use Azuriom\Http\Controllers\Controller;
+use Azuriom\Models\PrefixOperation;
+use Azuriom\Models\Server;
+use Illuminate\Http\Request;
+
+class PrefixOperationController extends Controller
+{
+    public function index(Request $request)
+    {
+        $query = PrefixOperation::query()->with(['user:id,name,game_id', 'server:id,name']);
+
+        if ($request->filled('user_id')) {
+            $query->where('user_id', (int) $request->input('user_id'));
+        }
+
+        if ($request->filled('player')) {
+            $name = (string) $request->input('player');
+            $query->whereHas('user', fn ($q) => $q->where('name', 'like', '%'.$name.'%'));
+        }
+
+        if ($request->filled('server_id')) {
+            $query->where('server_id', (int) $request->input('server_id'));
+        }
+
+        if ($request->filled('status')) {
+            $query->where('status', (string) $request->input('status'));
+        }
+
+        return view('admin.prefixes.operations', [
+            'operations' => $query->orderByDesc('created_at')->paginate(40)->withQueryString(),
+            'servers' => Server::query()->orderBy('position')->orderBy('name')->get(['id', 'name']),
+            'userId' => $request->input('user_id'),
+            'player' => $request->input('player'),
+            'serverId' => $request->input('server_id'),
+            'status' => $request->input('status'),
+        ]);
+    }
+}
diff --git a/app/Http/Controllers/Admin/PrefixUserController.php b/app/Http/Controllers/Admin/PrefixUserController.php
new file mode 100644
index 0000000..820e1f1
--- /dev/null
+++ b/app/Http/Controllers/Admin/PrefixUserController.php
@@ -0,0 +1,37 @@
+<?php
+
+namespace Azuriom\Http\Controllers\Admin;
+
+use Azuriom\Http\Controllers\Controller;
+use Azuriom\Models\Server;
+use Azuriom\Models\User;
+use Azuriom\Services\Prefix\PrefixSelection;
+use Illuminate\Http\RedirectResponse;
+use RuntimeException;
+
+class PrefixUserController extends Controller
+{
+    public function reset(User $user, Server $server, PrefixSelection $selection): RedirectResponse
+    {
+        abort_unless(PrefixSelection::enabled(), 404);
+
+        try {
+            $selection->select($user, $server->id, null, 'admin_reset');
+        } catch (RuntimeException $e) {
+            $message = match ($e->getMessage()) {
+                'prefix_not_synced' => trans('prefixes.admin.user.not_synced'),
+                'prefix_already_selected' => trans('prefixes.admin.user.already_auto'),
+                'prefix_op_pending' => trans('prefixes.admin.user.pending'),
+                default => trans('prefixes.admin.user.reset_failed'),
+            };
+
+            return redirect()
+                ->to(route('admin.users.edit', $user).'#user-prefixes')
+                ->with('error', $message);
+        }
+
+        return redirect()
+            ->to(route('admin.users.edit', $user).'#user-prefixes')
+            ->with('success', trans('prefixes.admin.user.reset_queued'));
+    }
+}
diff --git a/app/Providers/PrefixSelectionServiceProvider.php b/app/Providers/PrefixSelectionServiceProvider.php
new file mode 100644
index 0000000..4dad854
--- /dev/null
+++ b/app/Providers/PrefixSelectionServiceProvider.php
@@ -0,0 +1,32 @@
+<?php
+
+namespace Azuriom\Providers;
+
+use Azuriom\Http\Controllers\ProfilePrefixController;
+use Illuminate\Support\Facades\Route;
+use Illuminate\Support\ServiceProvider;
+
+/**
+ * Registers the cabinet POST /user/prefixes/select route on the web stack.
+ * The same action is also wired in routes/api.php (auth+web) so the form works
+ * even if this provider is not listed in bootstrap/providers.php.
+ */
+class PrefixSelectionServiceProvider extends ServiceProvider
+{
+    public function boot(): void
+    {
+        if ($this->app->routesAreCached()) {
+            return;
+        }
+
+        Route::middleware(['web', 'auth'])
+            ->prefix('user')
+            ->name('profile.')
+            ->group(function () {
+                if (! Route::has('profile.prefixes.select')) {
+                    Route::post('/prefixes/select', [ProfilePrefixController::class, 'select'])
+                        ->name('prefixes.select');
+                }
+            });
+    }
+}
