+++ b/app/Http/Controllers/ProfilePrefixController.php
@@ -0,0 +1,46 @@
+<?php
+
+namespace Azuriom\Http\Controllers;
+
+use Azuriom\Services\Prefix\PrefixSelection;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Validation\Rule;
+use RuntimeException;
+
+class ProfilePrefixController extends Controller
+{
+    public function select(Request $request, PrefixSelection $selection): RedirectResponse
+    {
+        abort_unless(PrefixSelection::enabled(), 404);
+
+        $data = $this->validate($request, [
+            'server_id' => ['required', 'integer', Rule::exists('servers', 'id')],
+            'group' => ['nullable', 'string', 'max:64'],
+        ]);
+
+        $group = filled($data['group'] ?? null) ? (string) $data['group'] : null;
+
+        try {
+            $selection->select($request->user(), (int) $data['server_id'], $group, 'profile');
+        } catch (RuntimeException $e) {
+            $message = match ($e->getMessage()) {
+                'prefix_staff_locked' => trans('prefixes.cabinet.staff_locked'),
+                'prefix_not_synced' => trans('prefixes.cabinet.not_synced'),
+                'prefix_not_available' => trans('prefixes.cabinet.not_available'),
+                'prefix_disabled' => trans('prefixes.cabinet.disabled'),
+                'prefix_already_selected' => trans('prefixes.cabinet.already_selected'),
+                'prefix_op_pending' => trans('prefixes.cabinet.pending'),
+                default => trans('prefixes.cabinet.failed'),
+            };
+
+            return to_route('profile.index')
+                ->with('error', $message)
+                ->withFragment('prefixes-tab');
+        }
+
+        return to_route('profile.index')
+            ->with('success', trans('prefixes.cabinet.queued'))
+            ->withFragment('prefixes-tab');
+    }
+}
diff --git a/app/Console/Commands/PrefixCheckCommand.php b/app/Console/Commands/PrefixCheckCommand.php
new file mode 100644
index 0000000..b593fea
--- /dev/null
+++ b/app/Console/Commands/PrefixCheckCommand.php
@@ -0,0 +1,100 @@
+<?php
+
+namespace Azuriom\Console\Commands;
+
+use Azuriom\Models\PrefixCatalog;
+use Azuriom\Models\PrefixOperation;
+use Azuriom\Models\UserServerPrefix;
+use Azuriom\Services\Prefix\PrefixFormatter;
+use Azuriom\Services\Prefix\PrefixSelection;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Route;
+use Illuminate\Support\Facades\Schema;
+
+/**
+ * Read-only dry-run: schema, flag, routes, formatter samples. Does not write.
+ *
+ *   php artisan prefixes:check
+ */
+class PrefixCheckCommand extends Command
+{
+    protected $signature = 'prefixes:check';
+
+    protected $description = 'Dry-run check of the prefix-selection site patch (no writes)';
+
+    public function handle(PrefixFormatter $formatter): int
+    {
+        $ok = true;
+
+        $tables = ['prefix_catalog', 'user_server_prefixes', 'prefix_operations'];
+        foreach ($tables as $table) {
+            $exists = Schema::hasTable($table);
+            $this->line(($exists ? '[ok]  ' : '[MISS] ').'table '.$table);
+            $ok = $ok && $exists;
+        }
+
+        $enabled = PrefixSelection::enabled();
+        $this->line('[info] prefixes.enabled = '.($enabled ? '1' : '0').' (endpoints 404 while off)');
+        $this->line('[info] prefixes.lease_seconds = '.(setting('prefixes.lease_seconds', 30)));
+
+        $routes = [
+            'azlink prefixes report' => $this->findPath('prefixes/report'),
+            'azlink prefixes operations' => $this->findPath('prefixes/operations'),
+            'azlink prefixes ack' => $this->findPath('prefixes/ack'),
+            'profile.prefixes.select' => Route::has('profile.prefixes.select'),
+            'admin.prefixes.index' => Route::has('admin.prefixes.index'),
+            'admin.prefixes.operations' => Route::has('admin.prefixes.operations'),
+        ];
+
+        foreach ($routes as $label => $present) {
+            $this->line(($present ? '[ok]  ' : '[MISS] ').'route '.$label);
+            $ok = $ok && (bool) $present;
+        }
+
+        if (! Route::has('profile.prefixes.select')) {
+            $this->warn('Add App\\Providers\\PrefixSelectionServiceProvider::class to bootstrap/providers.php,');
+            $this->warn('or keep the POST /api/profile/prefixes/select route from the api.php hunk.');
+        }
+
+        $samples = [
+            '&a[VIP] &fNick' => 'legacy',
+            '<gold>[VIP]</gold> <white>Nick' => 'minimessage',
+            '&#FFAA00[Hex]' => 'legacy-hex',
+        ];
+        foreach ($samples as $raw => $kind) {
+            $html = $formatter->toHtml($raw);
+            $this->line('[preview:'.$kind.'] '.$raw.' → '.$html);
+            if ($html === '' || str_contains($html, '<script')) {
+                $this->error('formatter produced empty or unsafe HTML for '.$kind);
+                $ok = false;
+            }
+        }
+
+        if ($ok && Schema::hasTable('prefix_catalog')) {
+            $this->line('[info] catalog rows: '.PrefixCatalog::query()->count());
+            $this->line('[info] user_server_prefixes rows: '.UserServerPrefix::query()->count());
+            $this->line('[info] prefix_operations rows: '.PrefixOperation::query()->count());
+        }
+
+        if (! $ok) {
+            $this->error('prefixes:check found problems (see MISS lines). No data was written.');
+
+            return self::FAILURE;
+        }
+
+        $this->info('prefixes:check passed (read-only).');
+
+        return self::SUCCESS;
+    }
+
+    private function findPath(string $needle): bool
+    {
+        foreach (Route::getRoutes() as $route) {
+            if (str_contains($route->uri(), $needle)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
diff --git a/tests/Feature/PrefixSelectionTest.php b/tests/Feature/PrefixSelectionTest.php
new file mode 100644
index 0000000..21729d8
--- /dev/null
+++ b/tests/Feature/PrefixSelectionTest.php
@@ -0,0 +1,226 @@
+<?php
+
+namespace Tests\Feature;
+
+use Azuriom\Models\PrefixCatalog;
+use Azuriom\Models\PrefixOperation as Op;
+use Azuriom\Models\Server;
+use Azuriom\Models\Setting;
+use Azuriom\Models\User;
+use Azuriom\Models\UserServerPrefix;
+use Azuriom\Services\Prefix\PrefixFormatter;
+use Azuriom\Services\Prefix\PrefixOperationQueue;
+use Azuriom\Services\Prefix\PrefixReporter;
+use Azuriom\Services\Prefix\PrefixSelection;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use RuntimeException;
+use Tests\TestCase;
+
+/**
+ * Requires a booted Azuriom app (phpunit.xml + sqlite).
+ *
+ *   cd /var/www/main-site
+ *   php artisan test --filter=PrefixSelectionTest
+ */
+class PrefixSelectionTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private User $user;
+
+    private Server $server;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->user = User::factory()->create([
+            'name' => 'Nick',
+            'game_id' => 'f3fc162dd34432fa8c9a0b987b0791cf',
+        ]);
+        $this->server = Server::query()->create([
+            'name' => 'ATM10-Test',
+            'address' => '127.0.0.1',
+            'type' => 'mc-azlink',
+            'port' => 25565,
+            'data' => [],
+        ]);
+
+        Setting::updateSettings(['prefixes.enabled' => '1', 'prefixes.lease_seconds' => '30']);
+    }
+
+    public function test_report_upserts_by_uuid_and_name(): void
+    {
+        $reporter = app(PrefixReporter::class);
+
+        $first = $reporter->report($this->server->id, [[
+            'uuid' => 'f3fc162d-d344-32fa-8c9a-0b987b0791cf',
+            'name' => 'Nick',
+            'available' => [
+                ['group' => 'vip', 'prefix_raw' => '<gold>[VIP]</gold>', 'category' => 'donate'],
+                ['group' => 'hidden', 'prefix_raw' => '&8[X]', 'category' => 'other'],
+            ],
+            'selected' => 'vip',
+            'locked_staff' => false,
+        ]]);
+
+        $this->assertSame(1, $first['stored']);
+        $this->assertSame(0, $first['skipped']);
+
+        $row = UserServerPrefix::query()->where('user_id', $this->user->id)->first();
+        $this->assertSame('vip', $row->selected);
+        $this->assertCount(2, $row->available);
+
+        $byName = User::factory()->create(['name' => 'OnlyName', 'game_id' => null]);
+        $second = $reporter->report($this->server->id, [[
+            'uuid' => '00000000-0000-0000-0000-000000000099',
+            'name' => 'OnlyName',
+            'available' => [],
+            'selected' => null,
+            'locked_staff' => true,
+        ]]);
+        $this->assertSame(1, $second['stored']);
+        $this->assertTrue(UserServerPrefix::query()->where('user_id', $byName->id)->first()->locked_staff);
+    }
+
+    public function test_unknown_player_is_skipped(): void
+    {
+        $result = app(PrefixReporter::class)->report($this->server->id, [[
+            'uuid' => 'aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee',
+            'name' => 'Missing',
+            'available' => [],
+            'selected' => null,
+            'locked_staff' => false,
+        ]]);
+
+        $this->assertSame(0, $result['stored']);
+        $this->assertSame(1, $result['skipped']);
+    }
+
+    public function test_select_creates_prefix_select_operation(): void
+    {
+        $this->seedSnapshot();
+
+        $op = app(PrefixSelection::class)->select($this->user, $this->server->id, 'vip', 'profile');
+
+        $this->assertSame(Op::TYPE_SELECT, $op->type);
+        $this->assertSame('vip', $op->group);
+        $this->assertSame(Op::PENDING, $op->status);
+        $this->assertSame('vip', UserServerPrefix::query()->where('user_id', $this->user->id)->value('selected'));
+    }
+
+    public function test_staff_locked_blocks_profile_select(): void
+    {
+        $this->seedSnapshot(locked: true);
+
+        $this->expectException(RuntimeException::class);
+        $this->expectExceptionMessage('prefix_staff_locked');
+        app(PrefixSelection::class)->select($this->user, $this->server->id, 'vip', 'profile');
+    }
+
+    public function test_disabled_catalog_entry_hidden_and_not_selectable(): void
+    {
+        $this->seedSnapshot();
+        PrefixCatalog::query()->create([
+            'group' => 'hidden',
+            'display_name' => 'Hidden',
+            'prefix_raw' => '&8[X]',
+            'category' => 'other',
+            'sort' => 1,
+            'enabled' => false,
+        ]);
+        PrefixCatalog::query()->create([
+            'group' => 'vip',
+            'display_name' => 'VIP',
+            'prefix_raw' => '<gold>[VIP]</gold>',
+            'category' => 'donate',
+            'sort' => 0,
+            'enabled' => true,
+        ]);
+
+        $row = UserServerPrefix::query()->where('user_id', $this->user->id)->first();
+        $options = app(PrefixSelection::class)->visibleOptions($row, PrefixCatalog::query()->get()->keyBy('group'));
+        $this->assertTrue($options->contains('group', 'vip'));
+        $this->assertFalse($options->contains('group', 'hidden'));
+
+        $this->expectException(RuntimeException::class);
+        $this->expectExceptionMessage('prefix_disabled');
+        app(PrefixSelection::class)->select($this->user, $this->server->id, 'hidden', 'profile');
+    }
+
+    public function test_pending_lease_and_idempotent_ack(): void
+    {
+        $this->seedSnapshot();
+        $queue = app(PrefixOperationQueue::class);
+        $op = $queue->enqueue($this->user, $this->server->id, 'vip', ['source' => 'profile']);
+
+        $first = $queue->pending($this->server->id, 50);
+        $this->assertCount(1, $first);
+        $this->assertSame($op->id, $first[0]['op_id']);
+        $this->assertSame('prefix_select', $first[0]['type']);
+        $this->assertSame('vip', $first[0]['group']);
+
+        $leased = $queue->pending($this->server->id, 50);
+        $this->assertCount(0, $leased);
+
+        $ack = $queue->ack($this->server->id, $op->id, Op::APPLIED, null, 'vip');
+        $this->assertSame(Op::APPLIED, $ack->status);
+        $this->assertSame('vip', UserServerPrefix::query()->where('user_id', $this->user->id)->value('selected'));
+
+        $again = $queue->ack($this->server->id, $op->id, Op::REJECTED, 'ignored', null);
+        $this->assertSame(Op::APPLIED, $again->status);
+        $this->assertSame('vip', UserServerPrefix::query()->where('user_id', $this->user->id)->value('selected'));
+    }
+
+    public function test_ack_rejected_keeps_previous_selection(): void
+    {
+        $this->seedSnapshot();
+        $queue = app(PrefixOperationQueue::class);
+        $op = $queue->enqueue($this->user, $this->server->id, null, ['source' => 'admin_reset']);
+        $queue->ack($this->server->id, $op->id, Op::REJECTED, 'staff_locked', 'vip');
+
+        $this->assertSame('vip', UserServerPrefix::query()->where('user_id', $this->user->id)->value('selected'));
+        $this->assertSame(Op::REJECTED, $op->fresh()->status);
+    }
+
+    public function test_formatter_legacy_and_minimessage(): void
+    {
+        $formatter = new PrefixFormatter();
+
+        $legacy = $formatter->toHtml('&a[VIP]');
+        $this->assertStringContainsString('#55FF55', $legacy);
+        $this->assertStringContainsString('[VIP]', $legacy);
+        $this->assertStringNotContainsString('&a', $legacy);
+
+        $mini = $formatter->toHtml('<gold>[VIP]</gold>');
+        $this->assertStringContainsString('#FFAA00', $mini);
+        $this->assertStringContainsString('[VIP]', $mini);
+
+        $escaped = $formatter->toHtml('<red>a<script>alert(1)</script>b</red>');
+        $this->assertStringNotContainsString('<script>', $escaped);
+        $this->assertStringContainsString('alert(1)', $escaped);
+    }
+
+    public function test_auto_select_enqueues_null_group(): void
+    {
+        $this->seedSnapshot();
+        $op = app(PrefixSelection::class)->select($this->user, $this->server->id, null, 'profile');
+        $this->assertNull($op->group);
+        $this->assertSame(Op::TYPE_SELECT, $op->type);
+    }
+
+    private function seedSnapshot(bool $locked = false): void
+    {
+        UserServerPrefix::query()->create([
+            'user_id' => $this->user->id,
+            'server_id' => $this->server->id,
+            'available' => [
+                ['group' => 'vip', 'prefix_raw' => '<gold>[VIP]</gold>', 'category' => 'donate'],
+                ['group' => 'hidden', 'prefix_raw' => '&8[X]', 'category' => 'other'],
+            ],
+            'selected' => 'vip',
+            'locked_staff' => $locked,
+            'synced_at' => now(),
+        ]);
+    }
+}
