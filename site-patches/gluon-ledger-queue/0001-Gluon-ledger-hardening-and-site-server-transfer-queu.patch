@@ -0,0 +1,40 @@
+<?php
+
+namespace Azuriom\Console\Commands;
+
+use Azuriom\Models\User;
+use Azuriom\Services\Currency\ServerOperationQueue;
+use Illuminate\Console\Command;
+
+/**
+ * Admin/test helper: queue a gluon transfer between the site wallet and a server wallet.
+ */
+class CurrencyQueueTransferCommand extends Command
+{
+    protected $signature = 'currency:queue-transfer {user : user id or name} {server : server id} {direction : to_server|from_server} {amount : positive integer}';
+
+    protected $description = 'Queue a site<->server gluon transfer (requires currency.server_queue_enabled)';
+
+    public function handle(ServerOperationQueue $queue): int
+    {
+        if (! ServerOperationQueue::enabled()) {
+            $this->error('currency.server_queue_enabled is off');
+
+            return self::FAILURE;
+        }
+
+        $ref = $this->argument('user');
+        $user = ctype_digit($ref) ? User::find((int) $ref) : User::where('name', $ref)->first();
+
+        if ($user === null) {
+            $this->error('User not found');
+
+            return self::FAILURE;
+        }
+
+        $op = $queue->enqueue($user, (int) $this->argument('server'), $this->argument('direction'), (int) $this->argument('amount'), ['source' => 'console']);
+        $this->info("Queued {$op->id} {$op->direction} {$op->amount} for {$user->name} (status {$op->status})");
+
+        return self::SUCCESS;
+    }
+}
